{
  "name": "el-rincon-de-warren",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "build:netlify": "vite build",
    "start": "node build/server.cjs --prod",
    "movil": "npm run build && npm start",
    "preview": "vite preview",
    "clean": "node -e \"for (const d of ['dist','build','.data']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "datos:referencia": "tsx scripts/actualizar-datos-referencia.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@netlify/blobs": "11.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "compression": "1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "serverless-http": "3.2.0",
    "vite": "^6.2.3",
    "yahoo-finance2": "4.0.2"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
